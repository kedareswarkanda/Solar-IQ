# SolarIQ — Environment Configuration Template

# MongoDB Database Connection (Supports MongoDB Atlas & Local Instances)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=solariq_db

# Weather API Key (Optional: Falls back to built-in climate presets if unconfigured)
WEATHER_API_KEY=your_weather_api_key_here

# SMTP Real Email OTP Configuration
# Configure your SMTP server credentials below to enable sending real verification emails to users.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=SolarIQ Verification <noreply@solariq.io>
SMTP_USE_TLS=true

# Server Configuration
HOST=127.0.0.1
PORT=8000
